diff --git a/hybris/common/tls_patcher.c b/hybris/common/tls_patcher.c
new file mode 100644
index 0000000..5913c33
--- /dev/null
+++ b/hybris/common/tls_patcher.c
@@ -0,0 +1,99 @@
+/*
